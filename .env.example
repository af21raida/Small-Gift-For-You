# Copy these into Netlify: Site configuration -> Environment variables.
# NEVER commit real values, and never put the service-role key in any file under src/ or dist/.

# Supabase project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase *service_role* secret (Project Settings -> API Keys). Server-side only: used by Netlify Functions.
# Mark it as a secret in Netlify and scope it to "Functions" (and Builds only if you need it there).
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string (e.g. `openssl rand -hex 32`). Used to hash client IPs for rate limiting,
# so raw IP addresses are never stored.
RATE_LIMIT_SALT=
